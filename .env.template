# ============================================================
# MLB Data Warehouse — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# ── SQL Server connection ────────────────────────────────────
MSSQL_SERVER=YOUR_SERVER_NAME
MSSQL_DATABASE=YOUR_DATABASE_NAME
MSSQL_USERNAME=YOUR_DB_USERNAME
MSSQL_PASSWORD=YOUR_DB_PASSWORD
# Set to 'yes' to use Windows Authentication instead of SQL auth
MSSQL_TRUSTED_CONNECTION=no
# ODBC driver name — check via: python -c "import pyodbc; print(pyodbc.drivers())"
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# ── dlt pipeline settings ────────────────────────────────────
DLT_PIPELINE_NAME=mlb_pipeline
DLT_DATASET_NAME=dw

# ── MLB Stats API ────────────────────────────────────────────
MLB_API_BASE_URL=https://statsapi.mlb.com/api/v1
# Optional: increase if you hit rate limits (seconds between requests)
MLB_API_DELAY=0

# ── dbt ──────────────────────────────────────────────────────
DBT_PROFILES_DIR=.
DBT_TARGET=dev

# ── ETL Monitor ──────────────────────────────────────────────
ETL_MONITOR_LOG_TABLE=etl_monitor
ETL_ALERT_EMAIL=YOUR_EMAIL@example.com

# ── GitHub (used only for documentation, not in code) ────────
GITHUB_REPO_URL=https://github.com/YOUR_GITHUB_USERNAME/mlb_dlt
