# Copy to .env (in PycharmProjects or each project folder) and fill in.
# .env is in .gitignore — never commit it.

MSSQL_DRIVER=ODBC Driver 17 for SQL Server
MSSQL_SERVER=Your_Database_Server
MSSQL_DATABASE=Your_Database_Name

# SQL authentication (MSSQL_TRUSTED_CONNECTION=no)
MSSQL_USERNAME=Your_USER
MSSQL_PASSWORD=Your_User_Password
# Set to yes to use Windows Authentication instead (username/password ignored)
MSSQL_TRUSTED_CONNECTION=no
MSSQL_TRUST_SERVER_CERTIFICATE=yes

# Optional overrides
# DBT_PROJECT_DIR=C:\Users\Keith\baseball-sql\DBT_BASEBALL_SQLSERVER
# PIPELINE_SCRIPT=C:\Users\Keith\PycharmProjects\mlb_orchestration\pipeline.py
